            style={styles.itemImage}
          />
          <View style={styles.itemInfo}>
            <Text style={styles.itemTitle}>Máscara Baule</Text>
            <Text style={styles.itemDescription}>
              Origem: Costa do Marfim. Utilizada em celebrações comunitárias.
            </Text>
            <Pressable
              style={styles.favoriteButton}
              onPress={() => alert('Máscara Baule favoritada!')}
            >
              <Text style={styles.favoriteButtonText}>Favoritar</Text>
            </Pressable>
          </View>
        </View>

        {/* PEÇA 2 */}
        <View style={styles.itemCard}>
          <Image
            source={{ uri: 'https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRMimVaf5wCruuVSVbKM6dP3q-KFFwCRaArlJDQRVRx8Q&s=10' }}
            style={styles.itemImage}
          />
          <View style={styles.itemInfo}>
            <Text style={styles.itemTitle}>Máscara Gelede (Yoruba)</Text>
            <Text style={styles.itemDescription}>
              Origem: Nigéria. Homenagem ao poder das matrizes ancestrais.
            </Text>
            <Pressable
              style={styles.favoriteButton}
              onPress={() => alert('Máscara Gelede favoritada!')}
            >
              <Text style={styles.favoriteButtonText}>Favoritar</Text>
            </Pressable>
          </View>
        </View>

      </ScrollView>

      {/* RODAPÉ FIXO */}
      <View style={styles.footer}>
        <Pressable onPress={() => alert('Você já está na página do Acervo')}>
          <Text style={styles.footerTextActive}>Acervo</Text>
        </Pressable>
        <Pressable onPress={() => alert('Navegando para Exposições')}>
          <Text style={styles.footerText}>Exposições</Text>
        </Pressable>
        <Pressable onPress={() => alert('Navegando para Informações')}>
          <Text style={styles.footerText}>Visitação</Text>
        </Pressable>
      </View>

    </SafeAreaView>
  );
}

