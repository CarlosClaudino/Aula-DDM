          style={styles.headerAvatar}
        />
      </View>

      {/* CONTEÚDO PRINCIPAL (SCROLLVIEW) */}
      <ScrollView style={styles.scrollContainer}>

        {/* CAMPO DE BUSCA */}
        <Text style={styles.inputLabel}>Pesquisar no acervo:</Text>
        <TextInput
          placeholder="Buscar por etnia, região ou ritual..."
          placeholderTextColor="#888888"
          style={styles.searchInput}
        />

        {/* EXPOSIÇÃO EM DESTAQUE */}
        <Text style={styles.sectionTitle}>Exposição em Destaque</Text>
